# mynotes server: secrets and endpoints. Copy to .env in this folder and keep it private.
# Never commit .env. Non-secret tuning lives in mynotes.yaml.

# Image release to run (e.g. 0.4.0); empty means the latest release. Pin it: the agents must
# run the same version, and updating means changing it here.
# MYNOTES_VERSION=

# Where the web UI/API is published on this host. Default: localhost only. With your own
# TLS-terminating proxy (pfSense/HAProxy, nginx...) in front, bind to the interface it reaches,
# e.g. 0.0.0.0:8765, and have the proxy send X-Forwarded-Proto: https.
MYNOTES_WEB_BIND=127.0.0.1:8765

# Only for the optional Caddy service (`docker compose --profile tls up -d`): the server's DNS
# name, for its certificate (e.g. notes.example.org).
MYNOTES_SERVER_HOST=

# PostgreSQL password: letters and digits only (it goes into a connection URL)
MYNOTES_COMPOSE_PG_PASSWORD=

# OpenSearch admin password: >= 8 chars with upper case, lower case, a digit and a special character.
MYNOTES_OPENSEARCH_PASSWORD=
MYNOTES_COMPOSE_OS_HEAP=2g
MYNOTES_OPENSEARCH_CHUNKS_ALIAS="mynotes_chunks"

# --- Model endpoints (required: there are no defaults) -----------------------
# Any OpenAI-compatible server works; see deployment/full-stack/.env.example for the choices.
MYNOTES_EMBEDDING_BASE_URL=
MYNOTES_EMBEDDING_API_KEY=
MYNOTES_EMBEDDING_MODEL=
MYNOTES_EMBEDDING_DIM=
MYNOTES_EMBEDDING_QUERY_TEMPLATE=

MYNOTES_RERANKER_PROVIDER="cohere"
MYNOTES_RERANKER_URL=
MYNOTES_RERANKER_API_KEY=
MYNOTES_RERANKER_MODEL=
MYNOTES_RERANKER_TOP_N=0

MYNOTES_LLM_BASE_URL=
MYNOTES_LLM_API_KEY=
MYNOTES_LLM_MODEL=
MYNOTES_LLM_TEMPERATURE="0.0"
MYNOTES_LLM_TIMEOUT_S="120"
MYNOTES_LLM_THINKING_MODEL=false
