# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Local data and results
eval/results/*.json
!eval/results/.gitkeep
backups/
scripts/.cache/
# Raw LLM drafts built from the private notes corpus (may quote credentials)
eval/golden_set_draft.yaml

# Test fixture PDFs are generated at test time (never committed)
tests/fixtures/docs/*.pdf

# Office/HTML/EPUB fixtures are generated at test time (never committed)
tests/fixtures/docs/*.docx
tests/fixtures/docs/*.pptx
tests/fixtures/docs/*.xlsx
tests/fixtures/docs/*.html
tests/fixtures/docs/*.epub
tests/fixtures/docs/*.doc

# OS / editor clutter
.DS_Store
._*
Thumbs.db
desktop.ini
.idea/
.vscode/
.crush/
eval/golden_set_draft_m5.yaml
