# mynotes environment: secrets and endpoints (see PLAN.md §12.1).
# Copy to .env, fill in the secrets, and keep it private (chmod 600).
# Never commit .env. Non-secret tuning lives in mynotes.yaml;
# any MYNOTES_* variable here overrides the matching YAML value.

# Config file location (optional; defaults to the per-OS config dir)
MYNOTES_CONFIG=

# docker compose (local infrastructure, see docs/infrastructure.md)
MYNOTES_COMPOSE_PG_PASSWORD=
MYNOTES_COMPOSE_PG_PORT=5432
MYNOTES_COMPOSE_OS_PORT=9200
MYNOTES_COMPOSE_OS_HEAP=2g

# PostgreSQL (source of truth); password = MYNOTES_COMPOSE_PG_PASSWORD, port = MYNOTES_COMPOSE_PG_PORT
MYNOTES_PG_DSN="postgresql+psycopg://mynotes:<password>@localhost:5432/mynotes"

# OpenSearch (hybrid search index; HTTPS with basic auth)
# The compose stack creates user "admin" with MYNOTES_OPENSEARCH_PASSWORD as its initial password,
# which must be strong: >= 8 chars with upper case, lower case, a digit and a special character.
MYNOTES_OPENSEARCH_URL="https://localhost:9200"
MYNOTES_OPENSEARCH_USER=admin
MYNOTES_OPENSEARCH_PASSWORD=
MYNOTES_OPENSEARCH_CHUNKS_ALIAS="mynotes_chunks"

# --- Model endpoints (required: there are no defaults) -----------------------
# Any OpenAI-compatible server works. Fill in one choice per service; the lines
# under each heading are examples, not defaults. Run `uv run mynotes check-endpoints`
# (or `docker compose run --rm init mynotes check-endpoints`) to test them.

# Embeddings (OpenAI-compatible /v1/embeddings). The dimension must match the model;
# changing model or dimension later means `mynotes index rebuild`.
#   OpenAI:  BASE_URL=https://api.openai.com/v1   MODEL=text-embedding-3-small  DIM=1536
#   Ollama:  BASE_URL=http://localhost:11434/v1   MODEL=bge-m3                  DIM=1024
#            (inside docker compose use http://host.docker.internal:11434/v1)
#   vLLM / Text Embeddings Inference: BASE_URL=http://<host>:<port>/v1, the served model and its dimension
# QUERY_TEMPLATE: how queries are sent; "{text}" unless the model card asks for a format,
# e.g. "Instruct: {task}\nQuery: {text}" (Nemotron, E5-Mistral) or "search_query: {text}" (nomic).
MYNOTES_EMBEDDING_BASE_URL=
MYNOTES_EMBEDDING_API_KEY=
MYNOTES_EMBEDDING_MODEL=
MYNOTES_EMBEDDING_DIM=
MYNOTES_EMBEDDING_QUERY_TEMPLATE=

# Reranker (optional, Cohere-style /v1/rerank). Leave the URL empty to skip reranking:
# results then keep their search order. Servers with this API: vLLM serving a reranker
# (e.g. BAAI/bge-reranker-v2-m3 at http://<host>:<port>/v1/rerank), Jina, Cohere.
MYNOTES_RERANKER_PROVIDER="cohere"
MYNOTES_RERANKER_URL=
MYNOTES_RERANKER_API_KEY=
MYNOTES_RERANKER_MODEL=
MYNOTES_RERANKER_TOP_N=0   # 0 = keep all, reorder only

# LLM (OpenAI-compatible /v1/chat/completions)
#   OpenAI:  BASE_URL=https://api.openai.com/v1   MODEL=gpt-4o-mini
#   Ollama:  BASE_URL=http://localhost:11434/v1   MODEL=qwen3:8b (or another chat model)
#   vLLM:    BASE_URL=http://<host>:<port>/v1      MODEL=<served model>
MYNOTES_LLM_BASE_URL=
MYNOTES_LLM_API_KEY=
MYNOTES_LLM_MODEL=
MYNOTES_LLM_TEMPERATURE="0.0"
MYNOTES_LLM_TIMEOUT_S="120"
# true only for models whose thinking mode is switched by chat_template_kwargs
# (Qwen3 on vLLM): the client then asks for thinking off. Other servers reject that field.
MYNOTES_LLM_THINKING_MODEL=false
